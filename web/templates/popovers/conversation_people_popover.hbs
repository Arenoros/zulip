<div class="popover-menu conversation-people-popover" data-simplebar data-simplebar-tab-index="-1">
    <ul role="menu" class="popover-menu-list">
        <li role="none" class="popover-menu-list-item text-item conversation-people-heading">{{t "People" }}</li>
        {{#each people}}
            <li role="none" class="link-item popover-menu-list-item">
                <a role="menuitem" class="conversation-people-member popover-menu-link" data-user-id="{{user_id}}" tabindex="0">
                    <span class="conversation-people-avatar-container">
                        <img class="conversation-people-avatar" src="{{avatar_url}}" alt="" />
                        {{#if user_circle_class}}
                            <span class="conversation-people-presence user-circle zulip-icon zulip-icon-{{user_circle_class}} {{user_circle_class}}"></span>
                        {{/if}}
                    </span>
                    <span class="conversation-people-text">
                        <span class="conversation-people-name">{{full_name}}</span>
                        {{#if is_me}}
                            <span class="conversation-people-caption">{{t "You" }}</span>
                        {{/if}}
                    </span>
                </a>
            </li>
        {{/each}}
        {{#if can_start_group_chat}}
            <li role="separator" class="popover-menu-separator"></li>
            <li role="none" class="link-item popover-menu-list-item">
                <a role="menuitem" class="conversation-people-start-group-chat popover-menu-link" tabindex="0">
                    <i class="popover-menu-icon zulip-icon zulip-icon-user-group-plus" aria-hidden="true"></i>
                    <span class="popover-menu-label">{{t "Start a group chat" }}</span>
                </a>
            </li>
        {{/if}}
    </ul>
</div>
