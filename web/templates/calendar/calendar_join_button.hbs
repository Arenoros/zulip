<div class="calendar-join-button-group">
    <button type="button" class="{{button_class}} calendar-join-button">
        <i class="zulip-icon zulip-icon-video-call" aria-hidden="true"></i>
        {{t "Join" }}
    </button>
    <button type="button" class="{{button_class}} calendar-join-options-button" aria-label="{{t 'More ways to join' }}" aria-haspopup="true">
        <i class="zulip-icon zulip-icon-chevron-down" aria-hidden="true"></i>
    </button>
</div>
