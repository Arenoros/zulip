<div class="calendar-grid {{#if is_side_by_side}}side-by-side{{/if}}" style="--calendar-day-count: {{day_count}}; --calendar-column-count: {{column_count}}; --calendar-rows-per-hour: {{rows_per_hour}};">
    <div class="calendar-grid-top">
        {{#if is_side_by_side}}
            <div class="calendar-grid-row calendar-grid-calendar-headers">
                <span class="calendar-grid-corner"></span>
                <div class="calendar-grid-days">
                    {{#each calendars}}
                        <div class="calendar-grid-calendar-header {{#if is_mine}}mine{{/if}}" {{#if color}}style="--calendar-person-color: {{color}};"{{/if}}>
                            <span class="calendar-grid-calendar-name">{{name}}</span>
                            {{#unless is_mine}}
                                <button type="button" class="calendar-icon-button calendar-grid-calendar-close tippy-zulip-delayed-tooltip" data-user-id="{{user_id}}" data-tippy-content="{{t 'Hide this calendar' }}" aria-label="{{t 'Hide this calendar' }}">
                                    <i class="zulip-icon zulip-icon-close" aria-hidden="true"></i>
                                </button>
                            {{/unless}}
                        </div>
                    {{/each}}
                </div>
            </div>
        {{/if}}
        <div class="calendar-grid-row calendar-grid-header">
            <span class="calendar-grid-corner"></span>
            <div class="calendar-grid-days">
                {{#each calendars}}
                    {{#each ../days}}
                        <div class="calendar-day-header {{#if is_today}}today{{/if}} {{#if @first}}first-of-calendar{{/if}}" title="{{label}}">
                            <span class="calendar-day-number">{{number}}</span>
                            <span class="calendar-day-weekday">{{weekday}}</span>
                        </div>
                    {{/each}}
                {{/each}}
            </div>
        </div>
        <div class="calendar-grid-row calendar-all-day-row">
            <span class="calendar-grid-corner"></span>
            <div class="calendar-grid-days calendar-all-day-events"></div>
        </div>
    </div>
    <div class="calendar-grid-row calendar-grid-body">
        <div class="calendar-time-column" aria-hidden="true">
            {{#each hours}}
                <span class="calendar-hour-label" style="top: {{top}}%;">{{label}}</span>
            {{/each}}
        </div>
        <div class="calendar-grid-days">
            {{#each calendars}}
                {{#each ../days}}
                    <div class="calendar-day-column {{#if is_today}}today{{/if}} {{#if @first}}first-of-calendar{{/if}}" data-date="{{date}}" {{#if ../color}}style="--calendar-person-color: {{../color}};"{{/if}}>
                        <div class="calendar-day-events"></div>
                        {{#if is_today}}
                            <div class="calendar-now-line"></div>
                        {{/if}}
                    </div>
                {{/each}}
            {{/each}}
        </div>
    </div>
</div>
