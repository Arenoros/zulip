<div id="meeting-rooms" class="settings-section" data-name="meeting-rooms">
    <p>
        {{t "Meeting rooms can be booked for meetings in the calendar. A room accepts a meeting only if no other meeting booked it at that time." }}
    </p>

    {{#if is_admin}}
    {{> ../components/action_button
      id="add-meeting-room-button"
      label=(t 'Add meeting room')
      variant="subtle"
      intent="brand"
      }}
    {{/if}}

    <div class="settings_panel_list_header">
        <h3 class="settings-table-title">{{t "Meeting rooms"}}</h3>
        {{> filter_text_input placeholder=(t 'Filter') aria_label=(t 'Filter meeting rooms')}}
    </div>

    <div class="progressive-table-wrapper" data-simplebar data-simplebar-tab-index="-1">
        <table class="table table-striped wrapped-table admin_meeting_rooms_table">
            <thead class="table-sticky-headers">
                <tr>
                    <th>{{t "Name" }}</th>
                    <th>{{t "Capacity" }}</th>
                    <th>{{t "Location" }}</th>
                    <th>{{t "Exchange mailbox" }}</th>
                    {{#if is_admin}}
                    <th class="actions">{{t "Actions" }}</th>
                    {{/if}}
                </tr>
            </thead>
            <tbody id="admin_meeting_rooms_table" data-empty="{{t 'No meeting rooms.' }}" data-search-results-empty="{{t 'No meeting rooms match your current filter.' }}"></tbody>
        </table>
    </div>
</div>
