<div id="message-row-{{message_list_id}}-{{msg/id}}" data-message-id="{{msg/id}}"
  class="message_row{{#unless msg/is_stream}} private-message{{/unless}}{{#if msg/sent_by_me}} own-message{{/if}}{{#if include_sender}} messagebox-includes-sender{{/if}}{{#if mention_classname}} {{mention_classname}}{{/if}}{{#if msg.unread}} unread{{/if}} {{#if msg.locally_echoed}}locally-echoed{{/if}} selectable_row {{#if is_hidden}}muted-message-sender{{/if}}"
  role="listitem">
    {{#if (or want_subscription_status_divider want_date_divider)}}
    <div class="unread_marker message_divider_unread_marker"><div class="unread-marker-fill"></div></div>
    <div class="message_feed_divider no-select">
        {{#if want_subscription_status_divider}}
        <span class="stream-status">
            {{#if msg/historical }}
                {{#tr}}
                    You unsubscribed from <z-stream-name></z-stream-name>.
                    {{#*inline "z-stream-name"}}{{> stream_privacy . }} {{msg/display_recipient}}{{/inline}}
                {{/tr}}
            {{else}}
                {{#tr}}
                    You subscribed to <z-stream-name></z-stream-name>.
                    {{#*inline "z-stream-name"}}{{> stream_privacy . }} {{msg/display_recipient}}{{/inline}}
                {{/tr}}
            {{/if}}
        </span>
        {{/if}}
        {{#if want_date_divider}}
            <div class="date-divider-content">
                <span class="scroll-to-time" role="button" tabindex="0">
                    {{{date_divider_html}}}
                </span>
            </div>
        {{/if}}
    </div>
    {{/if}}
    {{#if want_new_messages_divider}}
    <div class="new-messages-divider no-select">
        <span class="new-messages-divider-label">{{t "New messages" }}</span>
    </div>
    {{/if}}
    {{#if (or topic_card_hidden_replies topic_card_can_collapse)}}
    <div class="topic-card-hidden-replies no-select">
        {{#if topic_card_hidden_replies}}
            <span class="topic-card-hidden-replies-label" role="button" tabindex="0">{{topic_card_hidden_replies}}</span>
        {{/if}}
        {{#if topic_card_can_collapse}}
            <span class="topic-card-collapse" role="button" tabindex="0">{{t "Collapse replies" }}</span>
        {{/if}}
    </div>
    {{/if}}
    <div class="unread_marker message_unread_marker"><div class="unread-marker-fill"></div></div>
    <div class="messagebox">
        <div class="messagebox-content {{#if status_message}}is-me-message{{/if}}">
            {{> message_body .}}
            {{!-- message_edit_form.hbs is inserted here when editing a message. --}}
        </div>
    </div>
</div>
